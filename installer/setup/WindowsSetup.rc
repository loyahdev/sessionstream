#include <windows.h>
#include <commctrl.h>
#include <richedit.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// The NSIS engine locates its page host, navigation, and page controls by ID.
105 DIALOGEX 0, 0, 336, 213
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "SESSIONSTREAM SETUP", 1300, 16, 13, 144, 10
    PUSHBUTTON "Close", 1301, 287, 7, 33, 17, NOT WS_VISIBLE
    LTEXT "", 1302, 16, 29, 304, 1, NOT WS_VISIBLE
    CONTROL "", 1018, "Static", SS_BLACKRECT | NOT WS_VISIBLE, 16, 38, 304, 139
    LTEXT "", 1028, 16, 192, 106, 11, NOT WS_VISIBLE
    PUSHBUTTON "", IDCANCEL, 16, 182, 59, 19
    PUSHBUTTON "", 3, 118, 182, 57, 19, NOT WS_VISIBLE
    DEFPUSHBUTTON "", IDOK, 183, 178, 137, 27
END

102 DIALOGEX 0, 0, 304, 139
STYLE DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Review the license", 1311, 0, 5, 304, 28
    LTEXT "", 1006, 0, 36, 304, 14
    CONTROL "", 1000, RICHEDIT_CLASS, WS_BORDER | WS_VSCROLL |
        WS_TABSTOP | ES_MULTILINE | ES_READONLY, 0, 56, 303, 82
END

106 DIALOGEX 0, 0, 304, 139
STYLE DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Installing SessionStream", 1311, 0, 5, 304, 28
    LTEXT "This may take a moment.", 1312, 0, 38, 304, 14
    LTEXT "", 1006, 10, 70, 284, 11, SS_NOPREFIX | SS_PATHELLIPSIS
    CONTROL "", 1004, "msctls_progress32", 0, 10, 88, 284, 6
    LTEXT "", 1313, 0, 60, 304, 47, WS_CLIPSIBLINGS
    PUSHBUTTON "", 1027, 0, 113, 69, 16
    CONTROL "", 1016, "SysListView32", LVS_REPORT | LVS_SINGLESEL |
        LVS_NOCOLUMNHEADER | NOT WS_VISIBLE | WS_TABSTOP, 0, 110, 303, 28
END
