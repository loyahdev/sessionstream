# Cross-compile against Microsoft libraries prepared with xwin.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(SESSIONSTREAM_WINDOWS_ARCH "x64" CACHE STRING "x64 or arm64")
if(SESSIONSTREAM_WINDOWS_ARCH STREQUAL "x64")
    set(CMAKE_SYSTEM_PROCESSOR AMD64)
    set(SESSIONSTREAM_TRIPLE x86_64-pc-windows-msvc)
    set(SESSIONSTREAM_SDK_ARCH x86_64)
elseif(SESSIONSTREAM_WINDOWS_ARCH STREQUAL "arm64")
    set(CMAKE_SYSTEM_PROCESSOR ARM64)
    set(SESSIONSTREAM_TRIPLE aarch64-pc-windows-msvc)
    set(SESSIONSTREAM_SDK_ARCH aarch64)
else()
    message(FATAL_ERROR "SESSIONSTREAM_WINDOWS_ARCH must be x64 or arm64")
endif()
set(SESSIONSTREAM_LLVM "$ENV{SESSIONSTREAM_LLVM}" CACHE PATH "LLVM bin directory")
set(SESSIONSTREAM_WINDOWS_SDK "$ENV{SESSIONSTREAM_WINDOWS_SDK}" CACHE PATH "xwin splat directory")
set(SESSIONSTREAM_LLD "$ENV{SESSIONSTREAM_LLD}" CACHE FILEPATH "lld-link executable")
if(NOT EXISTS "${SESSIONSTREAM_WINDOWS_SDK}/crt/include/vector")
    message(FATAL_ERROR "Set SESSIONSTREAM_WINDOWS_SDK to the xwin splat directory")
endif()
set(CMAKE_C_COMPILER "${SESSIONSTREAM_LLVM}/clang-cl")
set(CMAKE_CXX_COMPILER "${SESSIONSTREAM_LLVM}/clang-cl")
set(CMAKE_C_COMPILER_TARGET "${SESSIONSTREAM_TRIPLE}")
set(CMAKE_CXX_COMPILER_TARGET "${SESSIONSTREAM_TRIPLE}")
set(CMAKE_LINKER "${SESSIONSTREAM_LLD}")
set(CMAKE_AR "${SESSIONSTREAM_LLVM}/llvm-lib")
set(CMAKE_RC_COMPILER "${SESSIONSTREAM_LLVM}/llvm-rc")
set(CMAKE_MT "${SESSIONSTREAM_LLVM}/llvm-mt")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(SESSIONSTREAM_HEADERS "/imsvc${SESSIONSTREAM_WINDOWS_SDK}/crt/include /imsvc${SESSIONSTREAM_WINDOWS_SDK}/sdk/include/ucrt /imsvc${SESSIONSTREAM_WINDOWS_SDK}/sdk/include/um /imsvc${SESSIONSTREAM_WINDOWS_SDK}/sdk/include/shared /imsvc${SESSIONSTREAM_WINDOWS_SDK}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${SESSIONSTREAM_HEADERS}")
set(CMAKE_CXX_FLAGS_INIT "${SESSIONSTREAM_HEADERS}")
set(CMAKE_RC_FLAGS_INIT "/I${SESSIONSTREAM_WINDOWS_SDK}/sdk/include/um /I${SESSIONSTREAM_WINDOWS_SDK}/sdk/include/shared")
set(SESSIONSTREAM_LIBRARIES "/libpath:${SESSIONSTREAM_WINDOWS_SDK}/crt/lib/${SESSIONSTREAM_SDK_ARCH} /libpath:${SESSIONSTREAM_WINDOWS_SDK}/sdk/lib/ucrt/${SESSIONSTREAM_SDK_ARCH} /libpath:${SESSIONSTREAM_WINDOWS_SDK}/sdk/lib/um/${SESSIONSTREAM_SDK_ARCH}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${SESSIONSTREAM_LIBRARIES}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${SESSIONSTREAM_LIBRARIES}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${SESSIONSTREAM_LIBRARIES}")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SESSIONSTREAM_WINDOWS_ARCH SESSIONSTREAM_LLVM SESSIONSTREAM_LLD SESSIONSTREAM_WINDOWS_SDK)
