{
  "name": "sessionstream",
  "version": "1.0.4",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "start:tunnel": "node scripts/quick-tunnel.mjs",
    "test": "node --expose-gc --test tests/*.test.mjs",
    "build:plugin": "zsh scripts/build-plugin.sh",
    "test:browser": "node tests/browser.mjs",
    "test:lifecycle": "node tests/runtime-lifecycle.mjs",
    "build:installer": "zsh scripts/build-installer.sh",
    "build:setup": "zsh installer/setup/build.sh artifacts",
    "build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:windows-installer": "node scripts/build-windows-installer.mjs",
    "install:plugin": "zsh scripts/install-plugin.sh",
    "package:source": "node scripts/package-source.mjs",
    "start:plugin": "node --expose-gc scripts/companion.mjs",
    "test:access": "node --expose-gc tests/access-browser.mjs",
    "test:render": "node --expose-gc tests/seek-reset.mjs && node --expose-gc tests/render-recovery.mjs",
    "test:startup": "node tests/controller-retry.mjs && node tests/controller-retry.mjs --restart && node tests/controller-protected-recovery.mjs && node tests/controller-start-race.mjs",
    "build:site": "node scripts/package-site.mjs",
    "deploy:site": "node scripts/package-site.mjs && npx wrangler deploy --config services/tunnel-broker/wrangler.jsonc",
    "test:accounts-web": "node --test tests/website-accounts.test.mjs tests/account-database.test.mjs tests/dashboard-client.test.mjs",
    "build:cloud-codec": "node scripts/build-cloud-codec.mjs"
  },
  "dependencies": {
    "@roamhq/wrtc": "^0.10.0",
    "opus-decoder": "0.7.12",
    "opusscript": "0.1.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@clerk/clerk-react": "5.61.11",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.187.0"
  }
}
